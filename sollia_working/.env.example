# Sollia environment configuration — copy to sollia_working/.env and fill in.
# .env is gitignored and OVERRIDES the process environment at import (see
# src/config/llm_config.py::_load_dotenv). NEVER commit real keys.

# ── LLM provider keys (the 8-tier chain needs at least one; all three gives
#    full resilience across 3 independent rate-limit domains) ────────────────
# OpenRouter (tier 1 Fable 5 — PAID — and tiers 5-8 free backups)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Groq (tiers 2-3: llama-3.3-70b / llama-3.1-8b — free dev tier)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here
# Groq limits are enforced PER ORGANIZATION (not per key) — extra keys from
# the SAME org add resilience but zero throughput. Keys from SEPARATE orgs
# multiply capacity: each org is an independent 30-RPM/TPM bucket. Tag them
# with the org-suffixed envs below (see GROQ_ORG_KEYS in llm_config.py;
# GROQ_API_KEY_2..11 are additional mac_studio-org keys).
# GROQ_API_KEY_BERKELEY_1=gsk_...
# GROQ_API_KEY_BERKELEY_2=gsk_...
# GROQ_API_KEY_BERKELEY_3=gsk_...
# GROQ_API_KEY_HEYSOLLIA_1=gsk_...
# GROQ_API_KEY_HEYSOLLIA_2=gsk_...
# GROQ_API_KEY_HEYSOLLIA_3=gsk_...

# Google AI Studio (tier 4: gemini-2.5-flash — free tier, independent account)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-your-key-here

# ── Optional data keys ───────────────────────────────────────────────────────
# FRED (Agent 5 macro series; free) https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-key-here

# ── Ops overrides (defaults shown; uncomment to change) ─────────────────────
# SOLLIA_MAX_COST_PER_RUN=1.00          # hard billed-USD cap per pipeline run
# SOLLIA_COST_SOFT_GATE=0.8             # fraction of cap spent -> free tiers only
# SOLLIA_MAX_LLM_CALLS_PER_RUN=300      # live-LLM-call abuse ceiling per run
# SOLLIA_MAX_SEC_FETCHES_PER_RUN=200    # live SEC fetch abuse ceiling per run
# SOLLIA_AGENT1_WINDOW_YEARS=5          # Agent 1 rolling window size
# SOLLIA_MAX_NO_CACHE_RUNS_PER_HOUR=5   # cache-bust (SOLLIA_LLM_NO_CACHE) limit
# SOLLIA_RATE_LIMIT_PER_MIN=10          # backend: analysis requests/min/IP
# SOLLIA_MAX_CONCURRENT_RUNS_PER_IP=2   # backend: concurrent runs/IP
# SOLLIA_MAX_RUNS_PER_DAY_PER_IP=20     # backend: daily runs/IP
# SOLLIA_MAX_BODY_BYTES=10240           # backend: max POST body size
# SOLLIA_CACHE_MAX_GB=10                # .cache size cap (LRU eviction)
