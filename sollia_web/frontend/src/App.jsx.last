import { useState, useReducer, useEffect, useCallback } from 'react';
import { motion, AnimatePresence } from 'framer-motion';

const API_BASE = 'http://localhost:8000';

const initialState = {
  loading: false,
  result: null,
  logs: [],
  error: null,
  activeTab: 'log'
};

function reducer(state, action) {
  switch (action.type) {
    case 'START': return { ...initialState, loading: true };
    case 'LOG': return { ...state, logs: [...state.logs, action.payload] };
    case 'RESULT': return { ...state, loading: false, result: action.payload };
    case 'ERROR': return { ...state, loading: false, error: action.payload };
    case 'SET_TAB': return { ...state, activeTab: action.payload };
    case 'RESET': return initialState;
    default: return state;
  }
}

export default function App() {
  const [agents, setAgents] = useState([]);
  const [selected, setSelected] = useState(['forensic', 'narrative']);
  const [ticker, setTicker] = useState('');
  const [state, dispatch] = useReducer(reducer, initialState);

  useEffect(() => {
    fetch(`${API_BASE}/api/agents`)
      .then(r => r.json())
      .then(data => {
        console.log("Loaded agents:", data.agents);
        setAgents(data.agents || []);
        setSelected(data.agents?.map(a => a.id) || ['forensic', 'narrative', 'follow_through']);
      })
      .catch(() => {
        setAgents([
          {id: 'forensic', name: 'CEO vs 10-K'},
          {id: 'narrative', name: 'News Sentiment'},
          {id: 'follow_through', name: 'Management Follow-Through'}
        ]);
        setSelected(['forensic', 'narrative', 'follow_through']);
      });
  }, []);

  const runAnalysis = useCallback(async () => {
    if (!ticker || selected.length === 0) return;
    dispatch({ type: 'START' });

    try {
      const res = await fetch(`${API_BASE}/api/analyze`, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ ticker: ticker.toUpperCase(), agents: selected })
      });

      if (!res.ok) throw new Error('Failed');
      const data = await res.json();

      if (data.log) {
        data.log.forEach((l, i) => setTimeout(() => dispatch({type:'LOG', payload: l}), i*20));
      }
      setTimeout(() => dispatch({type:'RESULT', payload: data}), 800);
    } catch (e) {
      dispatch({type:'ERROR', payload: e.message});
    }
  }, [ticker, selected]);

  const toggle = (id) => setSelected(p => p.includes(id) ? p.filter(x=>x!==id) : [...p, id]);

  return (
    <div className="min-h-screen bg-[#05060B] text-white p-8">
      <div className="max-w-5xl mx-auto">
        <h1 className="text-5xl font-bold mb-8">Sollia</h1>

        <div className="glass-card p-8 rounded-3xl mb-8">
          <input
            type="text"
            value={ticker}
            onChange={e => setTicker(e.target.value.toUpperCase().slice(0,5))}
            placeholder="NVDA"
            className="bg-[#0A0C14] border border-white/20 rounded-2xl px-6 py-4 text-3xl w-full mb-6"
          />

          <div className="mb-6">
            <p className="text-slate-400 mb-3">Agents</p>
            <div className="flex flex-wrap gap-3">
              {agents.map(a => (
                <button key={a.id} onClick={() => toggle(a.id)}
                  className={`px-6 py-3 rounded-2xl border transition-all ${selected.includes(a.id) ? 'border-blue-400 bg-blue-500/10' : 'border-white/10'}`}>
                  {a.name}
                </button>
              ))}
            </div>
          </div>

          <button onClick={runAnalysis}
            disabled={!ticker || selected.length===0 || state.loading}
            className="w-full py-4 bg-blue-600 hover:bg-blue-500 rounded-2xl font-bold text-lg disabled:opacity-50">
            {state.loading ? "Analyzing..." : "Run Analysis"}
          </button>
        </div>

        {state.error && <div className="text-red-400 mb-6">{state.error}</div>}

        {state.result && (
          <div className="space-y-8">
            <div className="glass-card p-10 text-center">
              <div className="text-8xl font-black text-emerald-400">{state.result.score}</div>
              <div className="text-2xl mt-2">Overall Score</div>
            </div>

            {state.result.follow_through && (
              <div className="glass-card p-8">
                <h2 className="text-3xl font-bold mb-4">Management Follow-Through</h2>
                <p className="text-4xl font-semibold text-emerald-400 mb-6">
                  {state.result.follow_through.score}% Score
                </p>
                <p className="text-slate-400 mb-6">{state.result.follow_through.conclusion}</p>
                
                <div className="space-y-4">
                  {state.result.follow_through.promises?.map((p, i) => (
                    <div key={i} className="border-l-4 border-emerald-500 pl-4 py-2">
                      <div className="font-medium">{p.text?.slice(0,120)}...</div>
                      <div className="text-sm text-slate-500 mt-1">
                        Status: <span className={p.status === 'EVIDENCE_FOUND' ? 'text-emerald-400' : 'text-red-400'}>{p.status}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}
