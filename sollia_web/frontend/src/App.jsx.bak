import { useState, useReducer, useEffect, useCallback } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import ScoreCard from './components/ScoreCard';
import AgentCard from './components/AgentCard';
import LogStream from './components/LogStream';
import JsonExport from './components/JsonExport';

const API_BASE = 'http://localhost:8000';

const initialState = { loading: false, result: null, logs: [], error: null, activeTab: 'log' };

function reducer(state, action) {
  switch (action.type) {
    case 'START': return { ...initialState, loading: true };
    case 'LOG': return { ...state, logs: [...state.logs, action.payload] };
    case 'RESULT': return { ...state, loading: false, result: action.payload };
    case 'ERROR': return { ...state, loading: false, error: action.payload };
    case 'SET_TAB': return { ...state, activeTab: action.payload };
    case 'RESET': return initialState;
    default: return state;
  }
}

export default function App() {
  const [agents, setAgents] = useState([]);
  const [selected, setSelected] = useState(['forensic', 'narrative']);
  const [ticker, setTicker] = useState('');
  const [state, dispatch] = useReducer(reducer, initialState);

  // Fetch agents from backend
  useEffect(() => {
    fetch(`${API_BASE}/api/agents`)
      .then(r => r.json())
      .then(data => {
        console.log("✅ Agents loaded from backend:", data.agents);
        setAgents(data.agents || []);
        setSelected(data.agents?.map(a => a.id) || ['forensic', 'narrative', 'follow_through']);
      })
      .catch(err => {
        console.error("❌ Failed to fetch agents:", err);
        setAgents([
          { id: 'forensic', name: 'CEO vs 10-K' },
          { id: 'narrative', name: 'News Sentiment' },
          { id: 'follow_through', name: 'Management Follow-Through' }
        ]);
        setSelected(['forensic', 'narrative', 'follow_through']);
      });
  }, []);

  const runAnalysis = useCallback(async () => {
    if (!ticker || selected.length === 0) return;
    dispatch({ type: 'START' });

    try {
      const response = await fetch(`${API_BASE}/api/analyze`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ticker: ticker.toUpperCase(), agents: selected })
      });

      if (!response.ok) throw new Error('Analysis failed');
      const data = await response.json();

      if (data.log) {
        data.log.forEach((l, i) => {
          setTimeout(() => dispatch({ type: 'LOG', payload: l }), i * 15);
        });
      }
      setTimeout(() => dispatch({ type: 'RESULT', payload: data }), (data.log?.length || 0) * 15 + 300);
    } catch (err) {
      console.error(err);
      dispatch({ type: 'ERROR', payload: err.message });
    }
  }, [ticker, selected]);

  const toggleAgent = (id) => {
    setSelected(prev => prev.includes(id) ? prev.filter(a => a !== id) : [...prev, id]);
  };

  return (
    <>
      <Background3D />
      <div className="aurora-layer" />
      <main className="relative z-10 min-h-screen px-4 sm:px-6 lg:px-8 py-6 max-w-7xl mx-auto">
        <motion.header style={{ opacity: 1 }} className="sticky top-0 z-20 pt-2 pb-4">
          <div className="glass-card p-5 flex flex-col lg:flex-row gap-4 items-stretch lg:items-end">
            <div className="flex-1">
              <label className="block text-xs text-slate-500 uppercase tracking-[0.2em] mb-2 font-medium">Ticker</label>
              <div className="flex gap-3 items-end">
                <input
                  type="text"
                  value={ticker}
                  onChange={e => setTicker(e.target.value.toUpperCase().slice(0, 5))}
                  placeholder="NVDA"
                  className="bg-[#06080D] border border-white/10 rounded-xl px-5 py-4 text-white text-3xl font-black tracking-[0.15em] placeholder-slate-700 w-full sm:w-44 text-center"
                />
                <motion.button
                  onClick={runAnalysis}
                  disabled={state.loading || !ticker.trim() || selected.length === 0}
                  className="px-8 py-4 rounded-xl font-bold bg-gradient-to-r from-blue-500 to-violet-500 disabled:opacity-50"
                >
                  {state.loading ? 'Running...' : 'Analyze'}
                </motion.button>
              </div>
            </div>

            <div className="flex-1">
              <label className="block text-xs text-slate-500 uppercase tracking-[0.2em] mb-2 font-medium">Agents</label>
              <div className="flex flex-wrap gap-2">
                {agents.map(agent => (
                  <button
                    key={agent.id}
                    onClick={() => toggleAgent(agent.id)}
                    className={`px-5 py-2.5 rounded-xl text-sm font-medium border transition-all ${
                      selected.includes(agent.id)
                        ? 'bg-blue-500/20 border-blue-400 text-blue-300'
                        : 'bg-white/5 border-white/10 hover:border-white/30'
                    }`}
                  >
                    {agent.name}
                  </button>
                ))}
              </div>
            </div>
          </div>
        </motion.header>

        <AnimatePresence>
          {state.result && !state.loading && (
            <div className="space-y-8 pb-16">
              <motion.section><ScoreCard result={state.result} /></motion.section>
              
              <motion.section className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                {state.result.forensic && <AgentCard title="CEO vs 10-K" label={state.result.forensic.discrepancy_label} conclusion={state.result.forensic.conclusion} topSignals={state.result.forensic.top_signals} type="forensic" index={0} />}
                {state.result.narrative && <AgentCard title="News Sentiment" label={state.result.narrative.sentiment_label} conclusion={state.result.narrative.conclusion} topSignals={state.result.narrative.top_signals} type="narrative" index={1} />}
                {state.result.follow_through && (
                  <AgentCard 
                    title="Management Follow-Through" 
                    label={`Score: ${state.result.follow_through.score}% — ${state.result.follow_through.promises?.length || 0} promises tracked`} 
                    conclusion={state.result.follow_through.conclusion || 'Top promises from company history'} 
                    topSignals={(state.result.follow_through.promises || []).map(p => ({
                      severity: p.status === 'EVIDENCE_FOUND' ? 'GREEN' : 'RED',
                      severity_color: p.status === 'EVIDENCE_FOUND' ? '#22C55E' : '#EF4444',
                      description: `[${p.status}] ${p.text?.slice(0, 100)}...`,
                      transcript_citation: p.evidence?.slice(0, 100) || 'No evidence found',
                      filing_citation: `Severity: ${p.severity}/10 | ${p.source || 'unknown'} | ${p.date || ''}`,
                    }))} 
                    type="follow_through" 
                    index={2} 
                  />
                )}
              </motion.section>
            </div>
          )}
        </AnimatePresence>

        {!state.result && !state.loading && (
          <div className="text-center py-20">
            <p className="text-slate-700 text-lg font-medium">Enter a ticker and select agents to begin</p>
          </div>
        )}
      </main>
    </>
  );
}
